{
  "name": "example",
  "version": "0.1.0",
  "description": "Example plugin: provider templates, a read-only MCP server and file renderers (Graphviz, draw.io)",
  "author": "code-assistant",
  "providerTemplates": [
    {
      "id": "ollama-local",
      "label": "Ollama (this machine)",
      "description": "Models served by Ollama on localhost.",
      "provider": "ollama",
      "config": {
        "base_url": "http://localhost:11434"
      }
    },
    {
      "id": "litellm-proxy",
      "label": "LiteLLM proxy",
      "description": "An OpenAI-compatible LiteLLM proxy on localhost:4000; paste its virtual key as API key.",
      "provider": "openai",
      "config": {
        "base_url": "http://localhost:4000/v1"
      }
    }
  ],
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    }
  },
  "fileRenderers": [
    {
      "label": "Graphviz",
      "files": [
        "*.dot",
        "*.gv"
      ],
      "kind": "command",
      "command": "dot -Tsvg",
      "output": "svg"
    },
    {
      "label": "draw.io",
      "files": [
        "*.drawio"
      ],
      "kind": "web",
      "url": "http://localhost:8080/?embed=1&proto=json&spin=1&offline=1&https=0&saveAndExit=0&noSaveBtn=1&noExitBtn=1&dark={dark}",
      "start": {
        "command": "docker",
        "args": [
          "run",
          "--rm",
          "--name",
          "code-assistant-drawio",
          "-p",
          "127.0.0.1:8080:8080",
          "jgraph/drawio"
        ],
        "timeoutSeconds": 300
      }
    }
  ]
}
